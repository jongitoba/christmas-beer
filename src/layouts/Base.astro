---
import '../styles/global.css';
import '../styles/charts.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Rangering av juleøl på den årlige juleølsmakingen.' } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Juleølsmaking' ? title : `${title} · Juleølsmaking`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;600;700&display=swap" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path class="hat" d="M5 18c0-6 4-11 10-11 3 0 5 1 6 3l2 5-5-1c0 2-1 4-3 4H5z" /><rect class="fur" x="3" y="17" width="16" height="4" rx="2" /><circle class="fur" cx="23.5" cy="15" r="2.5" /></svg>
          <span class="brand-text">Jule<span>øl</span>smaking</span>
        </a>
        <nav class="main" aria-label="Hovedmeny">
          <a href="/smaking/" aria-current={current('/smaking')}>Smaking</a>
          <a href="/resultater/" aria-current={current('/resultater')}>Resultater</a>
          <a href="/admin/" aria-current={current('/admin')} data-admin-link hidden>Admin</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">Julens vakreste happening · Copyright: <a href="https://jonoba.no">jonoba.no</a></div>
    </footer>
  </body>
</html>
